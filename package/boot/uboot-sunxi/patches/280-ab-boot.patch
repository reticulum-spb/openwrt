AB boot state and redundant MMC environment for Orange Pi Zero.

--- a/configs/orangepi_zero_defconfig
+++ b/configs/orangepi_zero_defconfig
@@ -18,3 +18,14 @@
 CONFIG_SPI=y
 CONFIG_USB_EHCI_HCD=y
 CONFIG_USB_OHCI_HCD=y
+CONFIG_ENV_SOURCE_FILE="orangepi_zero"
+CONFIG_ENV_IS_IN_MMC=y
+CONFIG_ENV_OFFSET=0xF0000
+CONFIG_ENV_SIZE=0x8000
+CONFIG_ENV_OFFSET_REDUND=0xF8000
+CONFIG_SYS_MMC_ENV_DEV=0
+CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
+# CONFIG_ENV_IS_IN_FAT is not set
+# CONFIG_ENV_IS_IN_SPI_FLASH is not set
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_BOOTCOUNT_ENV=y
+CONFIG_BOOTCOUNT_BOOTLIMIT=3

--- a/board/sunxi/orangepi_zero.env
+++ b/board/sunxi/orangepi_zero.env
@@ -0,0 +1,6 @@
+ab_state=stable_a
+bootcount=0
+bootlimit=3
+upgrade_available=0
+ab_env_seeded=0
+ab_rescue_boot=if test "${ab_state}" = "stable_a"; then setenv ab_rootpart 3; setenv ab_kernfile uImage_b; setenv ab_rescue_slot b; setenv ab_rescue_state stable_b; else setenv ab_rootpart 2; setenv ab_kernfile uImage_a; setenv ab_rescue_slot a; setenv ab_rescue_state stable_a; fi; if fatload mmc ${mmc_bootdev} ${kernel_addr_r} ${ab_kernfile}; then if part uuid mmc ${mmc_bootdev}:${ab_rootpart} ab_uuid; then setenv bootargs console=${console} earlyprintk root=PARTUUID=${ab_uuid} ab.slot=${ab_rescue_slot} ab.rootpart=${ab_rootpart} rstate=${ab_rescue_state} ab.rescue=1 ro rootwait; echo "A/B: rescue slot ${ab_rescue_slot}, root partition ${ab_rootpart}, kernel ${ab_kernfile}"; bootm ${kernel_addr_r}; fi; fi; hang
+altbootcmd=if test "${ab_state}" = "trial_a"; then setenv ab_state stable_b; setenv upgrade_available 0; setenv bootcount 0; if saveenv; then reset; else echo "Unable to persist A/B rollback"; hang; fi; elif test "${ab_state}" = "trial_b"; then setenv ab_state stable_a; setenv upgrade_available 0; setenv bootcount 0; if saveenv; then reset; else echo "Unable to persist A/B rollback"; hang; fi; else run ab_rescue_boot; fi
